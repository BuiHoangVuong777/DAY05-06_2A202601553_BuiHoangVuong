# Copy to .env:  cp .env.example .env
# Never commit .env or a real API key.

# ---- Answer generation (optional) ---------------------------------------
# Leave empty and the app still runs: /api/query returns the retrieved chunks
# labelled mode="fallback" instead of an AI-written answer.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Set for Azure OpenAI / OpenRouter / vLLM or any OpenAI-compatible
# gateway. Leave empty to use the default https://api.openai.com/v1
OPENAI_BASE_URL=

# MODEL_1 is tried first. MODEL_2 is the secondary, used only if MODEL_1 errors
# or returns nothing — leave it empty to disable the retry.
OPENAI_MODEL_1=gpt-4o-mini
OPENAI_MODEL_2=

OPENAI_MAX_TOKENS=1024
OPENAI_TIMEOUT=60

# ---- Retrieval -----------------------------------------------------------
TOP_K=5
CHROMA_COLLECTION=rag_chunks
# Must be multilingual (the corpus is Vietnamese) AND symmetric — do not use the
# e5 family here; see README "Changing the embedding model".
# Changing this invalidates existing vectors.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---- Ingestion -----------------------------------------------------------
# Ingest ../output/rag_chunks.jsonl on backend startup (idempotent).
AUTO_INGEST=true

# ---- Ports (host side) ---------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PUBLIC_PORT=8000
CHROMA_PUBLIC_PORT=8001

# ---- Internal wiring -----------------------------------------------------
# Where nginx proxies /api. Leave as-is unless you rename the backend service.
BACKEND_URL=http://backend:8000
