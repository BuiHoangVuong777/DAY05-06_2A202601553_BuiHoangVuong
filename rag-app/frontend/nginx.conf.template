server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy the API so the browser only ever talks to one origin — no CORS setup.
    # ${BACKEND_URL} is substituted at container start (see NGINX_ENVSUBST_FILTER
    # in docker-compose.yml, which stops envsubst eating $host / $remote_addr).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;   # answer generation can take a while
    }
}
