# Copy file này thành .env. Không commit .env hoặc API key.
APP_HOST=127.0.0.1
APP_PORT=8000

# Lấy key tại Google AI Studio. Khi bỏ trống, UI ghi rõ đang chạy rule fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_TIMEOUT_SECONDS=20

# false = trace chỉ lưu hash input; true chỉ dùng với data giả trong buổi demo/eval.
AI_TRACE_FULL_INPUT=false
