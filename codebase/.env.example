# Copy file này thành .env. Không commit .env hoặc API key.

# ---------------------------------------------------------------------------
# Đăng nhập VLearn — XÁC THỰC GIẢ LẬP
# Dự án chưa có xác thực thật. Đặt DEV_AUTH=false để chặn toàn bộ đăng nhập.
# Đây KHÔNG phải tài khoản VLearn thật; đổi lại trước khi demo.
# ---------------------------------------------------------------------------
DEV_AUTH=true
DEV_AUTH_USERNAME=vlearn
DEV_AUTH_PASSWORD=vlearn-dev

# Khoá ký cookie phiên. Bỏ trống thì server sinh ngẫu nhiên mỗi lần khởi động
# (phiên đăng nhập sẽ mất sau khi restart). Sinh khoá:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Host/port cho `python3 server.py`.
APP_HOST=127.0.0.1
APP_PORT=8000

# Lấy key tại https://console.anthropic.com/ . Bỏ trống vẫn chạy được (task_parser/weekly_summary
# sẽ tự fallback, không crash), chỉ mất phần AI parse/gợi ý.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Tạo tại Discord: Server Settings > Integrations > Webhooks. Bỏ trống thì nút "Chạy nhắc việc
# ngay" chỉ hiện message trên UI, không gửi thật, không crash.
DISCORD_WEBHOOK_URL=
